<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Photoshop AI Edit · 安装与卸载" Width="860" Height="640" MinWidth="640" MinHeight="480" WindowStartupLocation="CenterScreen" Background="#12161B" Foreground="#F3F5F7" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#B2BDCB"/><Setter Property="Background" Value="#252B33"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,12"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#81B9FF"/><Setter TargetName="Face" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><Grid Width="844" Height="600"><Grid.ColumnDefinitions><ColumnDefinition Width="276"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border BorderBrush="#303B49" BorderThickness="0,0,1,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#182B42" Offset="0"/><GradientStop Color="#0C1624" Offset="1"/></LinearGradientBrush></Border.Background><Grid Margin="38,48,28,28"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><Image x:Name="BrandImage" Width="112" Height="112" HorizontalAlignment="Left" Margin="0,12,0,24"/><TextBlock Text="P H O T O S H O P" Foreground="#62A9FF" FontSize="14" FontWeight="Bold"/><TextBlock Text="AI Edit" FontSize="48" FontWeight="Bold" Margin="0,12,0,18"/><TextBlock Text="只改你想改的地方。" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="框选 · 描述 · 生成 · 回填图层" FontSize="13" Foreground="#8393A7" Margin="0,12,0,0"/></StackPanel><TextBlock x:Name="VersionLabel" Grid.Row="1" Text="●  Windows 安装器" Foreground="#7FD9C2" FontSize="13"/></Grid></Border>
  <Grid Grid.Column="1" Margin="32,34,32,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="◇  插件管理向导" Foreground="#8295AD" FontSize="14"/><TextBlock x:Name="Heading" Text="把 AI 带进你的工作流。" FontSize="28" FontWeight="Bold" Margin="0,18,0,8"/><TextBlock x:Name="Subtitle" Text="安装到当前用户，无需管理员权限或开发工具。" Foreground="#A0ACBC" FontSize="13"/><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button x:Name="InstallTab" Content="安装 / 更新" Margin="0,0,8,0"/><Button x:Name="UninstallTab" Content="卸载插件"/></StackPanel></StackPanel>
   <Grid Grid.Row="1" Margin="0,22,0,14"><StackPanel x:Name="Steps"><TextBlock Text="01   保存文件，退出 Photoshop" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="完成操作后重新打开，即可加载插件" Margin="29,5,0,20" Foreground="#94A1B3" FontSize="13"/><TextBlock x:Name="StepTwo" Text="02   一键安装，保留你的数据" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="旧版文件自动备份，保留 Key 与任务历史" Margin="29,5,0,20" Foreground="#94A1B3" FontSize="13"/><TextBlock Text="03   按引导完成 API 设置" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="检查连接不会提交付费生图任务" Margin="29,5,0,0" Foreground="#94A1B3" FontSize="13"/></StackPanel><ScrollViewer x:Name="ResultPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="ResultTitle" FontSize="21" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock x:Name="ResultBody" Foreground="#B6C2D2" FontSize="14" LineHeight="24"/><Button x:Name="SaveLog" Content="保存诊断记录" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></ScrollViewer></Grid>
   <StackPanel Grid.Row="2"><ProgressBar x:Name="Progress" Height="4" Margin="0,0,0,12" IsIndeterminate="True" Visibility="Collapsed"/><Button x:Name="Primary" Content="安装 AI 局部改图  →" Background="#2878EE" Foreground="White" FontSize="18" FontWeight="SemiBold" Padding="14,17"/><DockPanel Margin="0,15,0,0"><TextBlock Text="Photoshop 2024 / 25.0 及以上" VerticalAlignment="Center" FontSize="12" Foreground="#8290A3"/><Button x:Name="Guide" Content="使用指南 ↗" Background="Transparent" Padding="4,3" FontSize="12" HorizontalAlignment="Right"/></DockPanel></StackPanel>
  </Grid>
 </Grid></Viewbox>
</Window>
